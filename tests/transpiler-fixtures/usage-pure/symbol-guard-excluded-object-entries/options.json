{
  "plugins": [
    [
      "@core-js",
      {
        "method": "usage-pure",
        "version": "4.0",
        "targets": {
          "ie": 11
        },
        "exclude": [
          "object/create",
          "object/define-properties",
          "object/define-property",
          "object/get-own-property-descriptor",
          "object/get-own-property-names"
        ]
      }
    ]
  ]
}

{
  "plugins": [
    [
      "@core-js",
      {
        "method": "usage-global",
        "version": "4.0",
        "targets": {
          "ie": 11
        },
        "exclude": [
          "es.map.constructor",
          "es.promise.constructor",
          "es.number.constructor",
          "es.iterator.constructor",
          "es.regexp.constructor",
          "web.url.constructor"
        ]
      }
    ]
  ]
}
